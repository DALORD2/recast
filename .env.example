# Server
PORT=3001
JWT_SECRET=replace-with-a-long-random-secret
DATA_DIR=./data
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Required for storyboard analysis and prompt writing
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Required for timestamped transcription and optional generated voiceover
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1

# Video provider adapter. Endpoint must accept multipart form-data:
# prompt, duration, keyframe (file), reference (optional file).
# It may return { "video_url": "https://..." } or { "job_id": "..." }.
# For async jobs, set VIDEO_PROVIDER_STATUS_URL with {job_id} in its path;
# status replies with { "status": "processing"|"completed"|"failed",
# "video_url": "https://..." }.
VIDEO_PROVIDER_NAME=generic
VIDEO_PROVIDER_URL=
VIDEO_PROVIDER_STATUS_URL=
VIDEO_PROVIDER_API_KEY=
VIDEO_COST_PER_SECOND_USD=0.10

# Optional S3-compatible object storage. If omitted, files persist under DATA_DIR.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Optional completion email via Resend
RESEND_API_KEY=
EMAIL_FROM=

